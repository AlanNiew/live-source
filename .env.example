# 环境变量模板：复制为 .env 后填写真实值
# 注意：.env 已被 .gitignore 排除，不要提交；格式必须 KEY=VALUE（无空格、无引号、无注释）

# API 访问令牌（/api/proxy 与 /api/generate-sign 的 Bearer 认证）
API_TOKEN=xxxx

# 上游 HNTV 官方接口签名密钥（sign = sha256(SECRET_KEY + timestamp)）
HNTV_SECRET_KEY=xxxx

# 管理后台（/admin）登录密码：留空/不配置 = 管理功能整体禁用（安全默认）。
# 公网部署务必设置强密码，并建议 nginx 反代加 HTTPS
ADMIN_PASSWORD=xxxx

# ---- 管理会话安全（上线加固，可选）----
# HTTPS 反代后设为 true：会话 Cookie 仅经 TLS 传输
SESSION_COOKIE_SECURE=false
# 管理会话有效期（小时，超时需重新登录）
ADMIN_SESSION_HOURS=12
# 登录防爆破：连续失败 N 次锁定（秒）
ADMIN_LOGIN_MAX_FAILURES=5
ADMIN_LOGIN_LOCKOUT_SECONDS=300

# 告警邮件接收地址（QQ/163/outlook/gmail 均支持）
email=xxxx@example.com

# 邮箱授权码（QQ/163 需在邮箱设置中开启 SMTP 后获取授权码）
password=xxxx

# B 站登录 Cookie（SESSDATA，解锁直播蓝光/原画；留空 = 游客 720P）。
# 获取：登录 bilibili.com → F12 Network → 复制 api.bilibili.com 请求的 Cookie 头（SESSDATA 为 HttpOnly，document.cookie 读不到）
# 注意：与 API_TOKEN 同等敏感（账号凭据），勿提交勿泄露；cookie 失效自动降级游客画质
BILIBILI_COOKIE=SESSDATA=xxxx
