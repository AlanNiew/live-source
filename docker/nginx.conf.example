# HNTV API nginx 反代示例（HTTPS + 登录限速）
#
# 用法：把本文件内容合并进你的 nginx 站点配置（/etc/nginx/sites-available/...），
# 替换 your-domain.com 与证书路径；证书可用 certbot/Let's Encrypt 免费签发。
# 完成后 .env 设 SESSION_COOKIE_SECURE=true，重启服务。
#
# 宿主机部署注意：容器映射端口 15002 只绑本机/内网（如 -p 127.0.0.1:15002:5002），
# 对外只暴露 nginx 的 443。

# 登录接口限速：每 IP 每分钟 5 次（防暴力破解，与应用内锁定双保险）
limit_req_zone $binary_remote_addr zone=admin_login:10m rate=5r/m;

server {
    listen 443 ssl http2;
    server_name your-domain.com;

    ssl_certificate     /etc/letsencrypt/live/your-domain.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/your-domain.com/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    # 管理登录接口：额外限速
    location = /api/admin/login {
        limit_req zone=admin_login burst=10 nodelay;
        proxy_pass http://127.0.0.1:5002;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # 其余全部转发（播放列表/EPG/管理后台）
    location / {
        proxy_pass http://127.0.0.1:5002;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
}

# HTTP 强制跳转 HTTPS
server {
    listen 80;
    server_name your-domain.com;
    return 301 https://$host$request_uri;
}
